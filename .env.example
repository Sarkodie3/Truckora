# ==============================================================================
# TRUCKORA ENVIRONMENT CONFIGURATION (.env.example)
# Truck Parts. Trusted Supply.
# Copy this file to .env.local and populate with your live credentials.
# ==============================================================================

# Next.js Application Public URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Found in Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Secret Service Role Key (NEVER expose to the client side / browser)
# Used only in server routes, webhooks, and administrative operations
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# ------------------------------------------------------------------------------
# DEFAULT STORE & TAX CONFIGURATION
# ------------------------------------------------------------------------------
DEFAULT_CURRENCY=EUR
DEFAULT_LOCALE=en-GB
DEFAULT_VAT_PERCENTAGE=21.0
ADMIN_EMAIL=admin@truckora.eu

# ------------------------------------------------------------------------------
# PAYMENT GATEWAY (STRIPE / MOLLIE / B2B BANK TRANSFER)
# ------------------------------------------------------------------------------
# Set to 'test' for simulation and development, or 'live' in production
PAYMENT_MODE=test
STRIPE_SECRET_KEY=sk_test_placeholder_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key_here
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_secret_here

# ------------------------------------------------------------------------------
# TRANSACTIONAL EMAIL SERVICE (RESEND / SENDGRID / POSTMARK)
# ------------------------------------------------------------------------------
EMAIL_SERVER_API_KEY=re_placeholder_email_api_key_here
EMAIL_FROM_ADDRESS=orders@truckora.eu
SUPPORT_EMAIL=support@truckora.eu
